# OmniSwitch Payment Gateway - Local Development Environment
# Copy this file to .env.local and fill in real values.
# This file is a TEMPLATE only and is never loaded by the app directly
# (ConfigModule only reads .env.local / .env, and neither is committed) -
# the values below are placeholders, not real secrets.
# NEVER commit .env.local to version control.

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0

# ─── Database (PostgreSQL Master/Replica) ────────────────────────────────────
# Host-side ports are remapped off Postgres's default 5432/5433 in
# docker-compose.yml, since a locally installed Postgres (Homebrew/
# Postgres.app) commonly already owns 127.0.0.1:5432 — connections would
# silently land on the wrong instance instead of failing loudly.
DB_MASTER_HOST=localhost
DB_MASTER_PORT=15432
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5433
DB_USERNAME=omniswitch
DB_PASSWORD=omniswitch_secret
DB_NAME=omniswitch_payments
DB_SSL=false
# DB_SSL_CA=/path/to/rds-ca-bundle.pem   # required when DB_SSL=true

# ─── Redis ───────────────────────────────────────────────────────────────────
# Host-side port is remapped off Redis's default 6379 — see the comment on
# docker-compose.yml's redis service for why (a locally installed Redis
# commonly already owns 127.0.0.1:6379).
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=redis_secret
REDIS_DB=0

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-in-production-must-be-at-least-32-chars

# ─── HMAC Signature Verification ─────────────────────────────────────────────
HMAC_SECRET=dev-hmac-secret-change-in-production

# ─── Vault (envelope-encrypts merchants.hmac_secret_ciphertext) ──────────────
# Dev-mode Vault only — a fixed root token is not acceptable in production,
# see docs/technical/secret-management.md.
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=omniswitch-dev-root-token

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL=60000
RATE_LIMIT_BURST_MAX=10
# Login-specific brute-force guard (POST /auth/token). Keep low in production.
AUTH_LOGIN_RATE_LIMIT=10

# ─── PSP Credentials (Test/Sandbox) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here
ADYEN_API_KEY=your_adyen_test_api_key_here
ADYEN_MERCHANT_ACCOUNT=TestMerchant
ADYEN_BASE_URL=https://checkout-test.adyen.com/v71
ADYEN_HMAC_KEY=your_adyen_webhook_hmac_key_hex_here

# FX rate source for converting a charge into a merchant's settlement
# currency, if they've set one (see docs/business-domain/ledger-and-settlement.md).
# Points at mock-psp's /fx/rates endpoint in local dev; not a real market-data provider.
FX_RATE_PROVIDER_URL=http://localhost:4000/fx

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4200
