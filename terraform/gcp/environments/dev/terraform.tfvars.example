# Copy to terraform.tfvars (gitignored) and fill in real values. Never
# commit the real file.

gcp_project_id = "your-gcp-project-id"
github_org     = "your-github-org"
github_repo    = "omniswitch-api"

# Uncomment to override defaults:
# region            = "us-east1"
# subnet_cidr       = "10.10.0.0/20"
# pods_cidr         = "10.20.0.0/16"
# services_cidr     = "10.30.0.0/20"
# github_deploy_ref = "refs/heads/main"
# kubernetes_version      = "latest"
# node_machine_type       = "e2-standard-4"
# node_min_count          = 1
# node_max_count          = 2
# gke_deletion_protection = false
# db_name                = "omniswitch_payments"
# db_username            = "omniswitch_admin"
# db_tier                = "db-custom-2-8192"
# db_availability_type   = "ZONAL"
# db_create_read_replica = false
# redis_tier             = "BASIC"
# redis_memory_size_gb   = 1
# hsm_allowed_member_emails = []
