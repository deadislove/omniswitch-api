# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/

# Environment files (NEVER commit secrets)
.env.local
.env.production
.env.staging
.env.*.local

# Logs
logs/
*.log
npm-debug.log*

# TypeScript
*.tsbuildinfo

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/

# K8s secrets (use sealed secrets or external secrets in CI/CD)
k8s/secret.yaml

# Load-test-generated credentials (dev/test merchants + JWTs, regenerated by
# scripts/load-test/setup-merchants.js each run — not meant to be committed)
scripts/load-test/.merchants.json
scripts/load-test/.payments.json

# Deterministically regenerated by generate-synthetic-history.ts (fixed
# seed — same output every run) — not meant to be committed.
scripts/calibration/synthetic-history.json
scripts/calibration/synthetic-agent-charges.json

#claude
.claude

# Terraform (real state, real cloud IDs — never commit; see terraform/README.md)
# .terraform.lock.hcl is deliberately NOT ignored — that file pins provider
# versions (like package-lock.json) and should be committed for reproducibility.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# backend.hcl holds the real state-bucket name (contains the AWS account ID)
# — real values, not for commit. .terraform.lock.hcl is a different file
# (provider version pins) and is NOT covered by this pattern.
backend.hcl
!backend.hcl.example
crash.log
crash.*.log

# Other
logs
spec