{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/contract/.*\\.contract-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!.*(@scure/base|@noble/hashes))"],
  "testTimeout": 30000,
  "maxWorkers": 1
}
