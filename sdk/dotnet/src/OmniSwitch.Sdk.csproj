<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OmniSwitch.Sdk</RootNamespace>
    <AssemblyName>OmniSwitch.Sdk</AssemblyName>
    <Version>0.1.0</Version>
    <Description>
      .NET client for the OmniSwitch payment gateway API — HMAC request
      signing, idempotency-key handling, and outbound webhook signature
      verification. Mirrors sdk/node's contract.
    </Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/deadislove/omniswitch-api</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Not the push destination itself — that's configured at publish
         time via `dotnet nuget add source` pointing at GitHub Packages
         (see .github/workflows/sdk-publish.yml). This is just package
         metadata NuGet.org/GitHub Packages both display. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
