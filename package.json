{
  "name": "omniswitch-api",
  "version": "1.0.0",
  "description": "Enterprise-grade Payment Gateway API Service - Modular Monolith + Hexagonal Architecture",
  "author": "Ta-Wei Lin",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest:e2e": "ts-node -r tsconfig-paths/register -r ./test/setup-env.ts ./node_modules/typeorm/cli.js -d src/database/data-source.ts migration:run",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "seed:admin": "ts-node -r tsconfig-paths/register src/database/seed-admin.ts",
    "job:archive": "ts-node -r tsconfig-paths/register src/jobs/run-archiving-job.ts",
    "job:delete": "ts-node -r tsconfig-paths/register src/jobs/run-deletion-job.ts",
    "job:drop-cutover-tables": "ts-node -r tsconfig-paths/register src/jobs/drop-cutover-tables.ts",
    "job:create-partitions": "ts-node -r tsconfig-paths/register src/jobs/create-partitions-job.ts",
    "load-test:charge": "artillery run scripts/load-test/artillery-config.yml",
    "load-test:read": "artillery run scripts/load-test/artillery-read-capacity.yml"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@azure/storage-blob": "^12.33.0",
    "@google-cloud/storage": "^8.0.1",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^5.4.0",
    "cache-manager-ioredis-yet": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.7.4",
    "csv-parser": "^3.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.3.0",
    "nest-winston": "^1.9.4",
    "otplib": "^13.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.0",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^1.1.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.67.0",
    "artillery": "^2.0.33",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^14.0.0",
    "jest": "^30.5.0",
    "prettier": "^3.2.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "typeorm": {
      "ioredis": "^6.0.0"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!.*(@scure/base|@noble/hashes))"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@domain/(.*)$": "<rootDir>/modules/payment/domain/$1",
      "^@ports/(.*)$": "<rootDir>/modules/payment/ports/$1",
      "^@adapters/(.*)$": "<rootDir>/modules/payment/adapters/$1",
      "^@application/(.*)$": "<rootDir>/modules/payment/application/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    }
  }
}
